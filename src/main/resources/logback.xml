<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. АППЕНДЕР ДЛЯ КОНСОЛИ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%-5level %d{HH:mm:ss} - %msg | [%thread] %logger{36}%n </pattern>
        </encoder>
    </appender>

    <!-- 2. АППЕНДЕР ДЛЯ ФАЙЛА -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${user.home}/WordAnalyzer/word-analyzer.log</file>
        <append>true</append> <!-- Добавлять в конец файла, а не перезаписывать -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>  <!-- Пропускать только INFO и выше -->
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%-5level %d{HH:mm:ss} - %msg | [%thread] %logger{36}%n </pattern>
        </encoder>
    </appender>

    <root level="DEBUG">  <!-- DEBUG для консоли -->
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="org.xerial" level="INFO"/>

</configuration>
